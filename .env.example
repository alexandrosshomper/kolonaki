# Supabase project settings
# Get these from: Supabase dashboard → Project Settings → API Keys
# This project uses the NEW Supabase API key format (Publishable + Secret),
# NOT the legacy format (anon + service_role). Do not use NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key — server-only, never expose to the browser
SUPABASE_SECRET_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog analytics (https://posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# Opt in to PostHog in `npm run dev`. Off by default — keeps prod analytics clean
# and silences transient PostHog 5xx that leak to console via the SDK. Set to "1"
# only when you need to verify event capture locally.
NEXT_PUBLIC_POSTHOG_DEV=

# Resend email (https://resend.com)
RESEND_API_KEY=

# Cron auth — generate with: openssl rand -hex 32
CRON_SECRET=
